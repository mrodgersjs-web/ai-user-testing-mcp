          "build/web"
        ]
      },
      {
        "argv": [
          "ln",
          "-sfn",
          "e2e/node_modules",
          "node_modules"
        ]
      },
      {
        "argv": [
          "cp",
          "/Users/rig128gb/Developer/ai-user-testing-mcp/projects/transformfit/cypress.suite.config.mjs",
          "cypress.config.mjs"
        ]
      },
      {
        "argv": [
          "ln",
          "-sfn",
          "../artifacts",
          "e2e/artifacts"
        ]
      },
      {
        "argv": [
          "mkdir",
          "-p",
          "artifacts/cypress/demo"
        ]
      },
      {
        "argv": [
          "python3",
          "scripts/certification/ai_usability_harness.py",
          "cypress-bind",
          "--lane",
          "demo",
          "--run-id",
          "suite-demo",
          "--build-dir",
          "build/web",
          "--output",
          "artifacts/cypress/demo/source-binding.json"
        ]
      }
