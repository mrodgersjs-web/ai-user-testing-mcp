[
  {
    "id": "tf-web-onboarding",
    "project": "transformfit",
    "platforms": [
      "web"
    ],
    "title": "New user completes onboarding and reaches the initial daily plan",
    "persona": "first-day lifter",
    "steps": [
      {
        "action": "open",
        "target": "/onboarding",
        "expected": "onboarding step 1 renders"
      },
      {
        "action": "fill-and-advance",
        "target": "all onboarding steps",
        "expected": "initial daily plan is shown"
      },
      {
        "action": "persist-check",
        "target": "reload",
        "expected": "plan survives reload"
      }
    ],
    "requiredAdapters": [
      "cypress"
    ],
    "requiredEvidence": [
      "log",
      "json_report"
    ],
    "execution": {
      "argv": [
        [
          "npx",
          "cypress",
          "run",
          "--config",
          "video=false",
          "--spec",
          "e2e/cypress/e2e/client-workflows.cy.ts"
        ]
      ],
      "env": {
        "CYPRESS_BASE_URL": "http://127.0.0.1:7358",
        "CYPRESS_EVIDENCE_LANE": "demo",
        "CYPRESS_CACHE_FOLDER": "/Users/rig128gb/Library/Caches/Cypress"
      },
      "server": {
        "argv": [
          "python3",
          "scripts/serve_web_spa.py",
          "--directory",
          "build/web",
          "--host",
          "127.0.0.1",
          "--port",
          "7358"
        ],
        "readyUrl": "http://127.0.0.1:7358/",
        "timeoutMs": 45000
      }
    }
  },
