# Copy names only — real values live in keychain / provider store, never in Git.
# The runner resolves these at execution time and never logs values.

# GitHub token for catalog resolution (or use `gh auth token`).
# GH_TOKEN=

# Paid-provider credentials (resolved from the existing provider store; the
# adapters fail closed with credential_missing when absent — never set fake values).
# TESTSPRITE_API_KEY=
# TESTMU_ACCESS_KEY=

# Optional: override sandbox base directory (defaults to OS temp under 0700).
# RIG_TESTLAB_SANDBOX_BASE=

# Optional: evidence store root (defaults to .rig-testlab/evidence).
# RIG_TESTLAB_EVIDENCE_ROOT=
