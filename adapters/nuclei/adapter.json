{
  "id": "nuclei",
  "name": "Nuclei template scanner",
  "adapterVersion": "1.0.0",
  "sourceEntryId": "projectdiscovery--nuclei",
  "status": "reviewed",
  "commandAllowlist": [
    [
      "nuclei",
      "-target"
    ],
    [
      "node"
    ]
  ],
  "networkAllowlist": [
    "127.0.0.1",
    "cloud.projectdiscovery.io"
  ],
  "limits": {
    "maxCpuMs": 300000,
    "maxMemoryMb": 2048,
    "maxWallClockS": 600,
    "maxOutputBytes": 10485760
  },
  "credentialMode": "none",
  "paidProvider": false,
  "fixtures": {
    "passing": "fixtures/passing.mjs",
    "plantedFailing": "fixtures/planted-failing.mjs",
    "unavailableDependency": "fixtures/unavailable.mjs"
  },
  "evidenceKinds": [
    "json_report",
    "log"
  ]
}
