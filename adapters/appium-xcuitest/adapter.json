{
  "id": "appium-xcuitest",
  "name": "Appium XCUITest (iOS simulator)",
  "adapterVersion": "1.0.0",
  "sourceEntryId": "appium-appium-io",
  "status": "reviewed",
  "commandAllowlist": [
    [
      "npx",
      "appium"
    ],
    [
      "xcrun",
      "simctl"
    ],
    [
      "node"
    ]
  ],
  "networkAllowlist": [
    "127.0.0.1"
  ],
  "limits": {
    "maxCpuMs": 300000,
    "maxMemoryMb": 4096,
    "maxWallClockS": 600,
    "maxOutputBytes": 10485760
  },
  "credentialMode": "none",
  "paidProvider": false,
  "fixtures": {
    "passing": "fixtures/passing.mjs",
    "plantedFailing": "fixtures/planted-failing.mjs",
    "unavailableDependency": "fixtures/unavailable.mjs"
  },
  "evidenceKinds": [
    "video",
    "screenshot",
    "log"
  ]
}
