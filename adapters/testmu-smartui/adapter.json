{
  "id": "testmu-smartui",
  "name": "TestMu SmartUI (paid visual grid)",
  "adapterVersion": "1.0.0",
  "sourceEntryId": "smartui-by-testmu-ai-formerly-lambdatest--www-testmuai-com",
  "status": "reviewed",
  "commandAllowlist": [
    [
      "npx",
      "smartui"
    ],
    [
      "node"
    ]
  ],
  "networkAllowlist": [
    "api.testmuai.com"
  ],
  "limits": {
    "maxCpuMs": 300000,
    "maxMemoryMb": 2048,
    "maxWallClockS": 600,
    "maxOutputBytes": 10485760
  },
  "credentialMode": "keychain",
  "paidProvider": true,
  "paidGuards": {
    "maxScenarios": 5,
    "maxEstimatedCredits": 10
  },
  "fixtures": {
    "passing": "fixtures/passing.mjs",
    "plantedFailing": "fixtures/planted-failing.mjs",
    "unavailableDependency": "fixtures/unavailable.mjs"
  },
  "evidenceKinds": [
    "screenshot",
    "json_report"
  ]
}
