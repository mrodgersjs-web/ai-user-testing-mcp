{
  "id": "watir",
  "name": "Watir (Ruby web runner)",
  "adapterVersion": "1.0.0",
  "sourceEntryId": "watir-watir-github-io",
  "status": "reviewed",
  "commandAllowlist": [
    [
      "bundle",
      "exec",
      "rspec"
    ],
    [
      "bundle",
      "exec",
      "cucumber"
    ],
    [
      "node"
    ]
  ],
  "networkAllowlist": [],
  "limits": {
    "maxCpuMs": 300000,
    "maxMemoryMb": 2048,
    "maxWallClockS": 600,
    "maxOutputBytes": 10485760
  },
  "credentialMode": "none",
  "paidProvider": false,
  "fixtures": {
    "passing": "fixtures/passing.mjs",
    "plantedFailing": "fixtures/planted-failing.mjs",
    "unavailableDependency": "fixtures/unavailable.mjs"
  },
  "evidenceKinds": [
    "screenshot",
    "log"
  ]
}
