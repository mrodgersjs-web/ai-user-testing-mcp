{
  "id": "owasp-zap",
  "name": "OWASP ZAP baseline",
  "adapterVersion": "1.0.0",
  "sourceEntryId": "zaproxy--zaproxy",
  "status": "reviewed",
  "commandAllowlist": [
    [
      "docker",
      "run",
      "ghcr.io/zaproxy/zaproxy"
    ],
    [
      "zap-baseline.py"
    ],
    [
      "node"
    ]
  ],
  "networkAllowlist": [
    "127.0.0.1"
  ],
  "limits": {
    "maxCpuMs": 300000,
    "maxMemoryMb": 2048,
    "maxWallClockS": 600,
    "maxOutputBytes": 10485760
  },
  "credentialMode": "none",
  "paidProvider": false,
  "fixtures": {
    "passing": "fixtures/passing.mjs",
    "plantedFailing": "fixtures/planted-failing.mjs",
    "unavailableDependency": "fixtures/unavailable.mjs"
  },
  "evidenceKinds": [
    "json_report",
    "log"
  ]
}
